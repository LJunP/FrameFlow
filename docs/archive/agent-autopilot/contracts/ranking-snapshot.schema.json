{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schemas/ranking-snapshot.schema.json",
  "type": "object",
  "required": ["schemaVersion", "snapshotId", "batchId", "algorithm", "weights", "candidateSetDigest", "entries", "createdAt"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "snapshotId": {"type": "string"},
    "batchId": {"type": "string"},
    "algorithm": {"type": "object", "required": ["id", "version"]},
    "weights": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "candidateSetDigest": {"type": "string"},
    "entries": {"type": "array", "items": {"type": "object", "required": ["candidateId", "rank", "eligible", "score", "scoreBreakdown"], "properties": {"candidateId": {"type": "string"}, "rank": {"type": "integer", "minimum": 1}, "eligible": {"type": "boolean"}, "score": {"type": "number"}, "scoreBreakdown": {"type": "object"}}}},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
