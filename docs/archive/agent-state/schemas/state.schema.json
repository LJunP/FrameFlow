{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schemas/autopilot-state.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "status",
    "activeStage",
    "target",
    "externalValidation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "project": {
      "const": "FrameFlow Select"
    },
    "status": {
      "enum": [
        "BOOTSTRAP_PENDING",
        "MIGRATING",
        "DEVELOPING",
        "VERIFYING",
        "LOCAL_MVP_COMPLETE",
        "HARD_BLOCKED_WITH_MAXIMUM_LOCAL_DELIVERY",
        "FAILED"
      ]
    },
    "activeStage": {
      "type": [
        "string",
        "null"
      ]
    },
    "activeTask": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastAcceptedTask": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastGate": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "const": "LOCAL_MVP_COMPLETE"
    },
    "externalValidation": {
      "enum": [
        "PENDING",
        "EXTERNAL_VALIDATION_PENDING",
        "UNVERIFIED",
        "READY_FOR_PILOT",
        "VALIDATED",
        "FAILED"
      ]
    },
    "attempts": {
      "type": "object"
    },
    "decisions": {
      "type": "array"
    },
    "blockers": {
      "type": "array"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
