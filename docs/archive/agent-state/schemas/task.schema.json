{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schemas/autopilot-task.schema.json",
  "title": "FrameFlow Select Autopilot Task",
  "type": "object",
  "required": [
    "taskId",
    "stage",
    "goal",
    "nonGoals",
    "readSet",
    "writeSet",
    "allowedCommands",
    "acceptance",
    "tests",
    "evidence",
    "rollback",
    "status"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^FF-[A-Z]+-[0-9]{3}$"
    },
    "stage": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readSet": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "writeSet": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "allowedCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "networkPolicy": {
      "enum": [
        "OFF",
        "OFFICIAL_DEPENDENCIES_ONLY",
        "PUBLIC_DOCS_AND_DEPENDENCIES"
      ]
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "acceptanceId",
          "path"
        ],
        "properties": {
          "acceptanceId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "rollback": {
      "type": "string"
    },
    "fallback": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "IMPLEMENTING",
        "VERIFYING",
        "ACCEPTED",
        "REJECTED",
        "BLOCKED",
        "NARROWED"
      ]
    }
  },
  "additionalProperties": true
}
