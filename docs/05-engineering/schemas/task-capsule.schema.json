{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frameflow-task-capsule.schema.json",
  "title": "FrameFlow Task Capsule v2",
  "description": "多 Agent 调度工具派发 FrameFlow 开发任务的统一结构化格式（v2：安全派发协议）。",
  "type": "object",
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000\\r\\n]+$",
      "description": "仓库相对路径或受控 glob；禁止绝对路径、Windows 盘符、反斜杠、空段、.. 路径段和 .git 内容"
    },
    "safeCommand": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\r\\n])(?!.*(?:[;&|<>`]|\\$\\()).+$",
      "description": "单条直接命令；禁止换行、命令替换、管道、重定向和 shell 控制操作符"
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "status",
    "title",
    "track",
    "stage",
    "roleType",
    "specialty",
    "goal",
    "readSet",
    "writeSet",
    "allowedCommands",
    "networkPolicy",
    "toolCapabilities",
    "nonGoals",
    "prerequisiteTaskIds",
    "facts",
    "decisions",
    "unknowns",
    "techBoundary",
    "businessRules",
    "acceptance",
    "evidence",
    "requirementIds",
    "testIds",
    "rollback",
    "approvalPoints",
    "budget"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "taskId": {
      "type": "string",
      "pattern": "^FF-(PP|P0|M[0-9]{2}[A-Z]?)-[0-9]{3}$",
      "description": "统一任务编号（方案 A）：FF-P0-001、FF-PP-001、FF-M01-001、FF-M04A-001、FF-M16G-001"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "NOT_READY", "CONTRACT_READY", "AVAILABLE", "READY_FOR_DISPATCH", "IN_PROGRESS", "BLOCKED", "DONE"],
      "description": "NOT_READY=契约、前置任务、用户授权或必需环境任一未满足，禁止派发；CONTRACT_READY=API/契约已定稿但前置条件未全部满足；AVAILABLE=可候选派发；READY_FOR_DISPATCH=前置、授权与环境复核通过，正式可派发"
    },
    "title": { "type": "string", "minLength": 3 },
    "track": {
      "type": "string",
      "enum": ["product-mainline", "engineering-lab", "prep"]
    },
    "stage": {
      "type": "string",
      "pattern": "^(P0-Prep|P0|M[0-9]{2}(?:-[A-Z])?)$",
      "description": "规范阶段名：P0-Prep、P0、M01、M04-A、M16-G"
    },
    "roleType": {
      "type": "string",
      "enum": ["planner", "architect", "implementer", "verifier", "reviewer"]
    },
    "specialty": {
      "type": "string",
      "enum": ["general", "test", "security", "reliability", "code", "operations"],
      "description": "与控制面角色枚举兼容：test-designer→specialty=test 等"
    },
    "goal": { "type": "string", "minLength": 10 },
    "readSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repoPath" }
    },
    "writeSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repoPath" },
      "description": "执行者可写的仓库相对路径；不得包含权威契约目录或当前 Task Capsule 自身。任务状态由调度器依据合法 Receipt 回写，不由执行者自改；其他派生索引与证据回写路径须显式声明"
    },
    "allowedCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pattern", "policy"],
        "properties": {
          "pattern": { "$ref": "#/$defs/safeCommand" },
          "policy": { "type": "string", "enum": ["exact", "prefix"] }
        },
        "additionalProperties": false
      },
      "description": "命令白名单，逐条声明；不在名单中的命令默认拒绝。prefix 只在完整相等或其后紧跟一个 ASCII 空格时匹配，禁止纯字符串前缀匹配"
    },
    "networkPolicy": {
      "type": "object",
      "required": ["allowExternal", "allowLocal", "allowRegistry"],
      "properties": {
        "allowExternal": { "type": "boolean" },
        "allowLocal": { "type": "boolean" },
        "allowRegistry": { "type": "boolean", "description": "是否允许访问 Maven Central 等包仓库" }
      },
      "additionalProperties": false
    },
    "toolCapabilities": {
      "type": "array",
      "items": { "type": "string", "enum": ["repo-read", "repo-list", "repo-write", "git-read", "test-run", "docs-index", "kubectl", "docker", "mcp-read"] }
    },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "prerequisiteTaskIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^FF-(PP|P0|M[0-9]{2}[A-Z]?)-[0-9]{3}$" }
    },
    "facts": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "techBoundary": {
      "type": "object",
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "businessRules": { "type": "array", "items": { "type": "string" } },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["acceptanceId", "criterion", "testIds", "evidenceIds"],
        "properties": {
          "acceptanceId": { "type": "string", "pattern": "^AC-FF-(PP|P0|M[0-9]{2}[A-Z]?)-[0-9]{3}-[0-9]{2}$" },
          "criterion": { "type": "string" },
          "testIds": { "type": "array", "items": { "type": "string" } },
          "evidenceIds": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "description": "每条验收必须显式映射 testIds 与 evidenceIds"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "command", "expected", "outputRef"],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^EV-FF-(PP|P0|M[0-9]{2}[A-Z]?)-[0-9]{3}-[0-9]{2}$" },
          "command": { "$ref": "#/$defs/safeCommand" },
          "expected": { "type": "string" },
          "outputRef": { "$ref": "#/$defs/repoPath" }
        },
        "additionalProperties": false
      }
    },
    "requirementIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$" },
      "description": "必须在需求注册表中存在"
    },
    "testIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TEST-FF-(PP|P0|M[0-9]{2}[A-Z]?)-[0-9]{3}-[0-9]{2}$" }
    },
    "rollback": { "type": "string", "description": "禁止删除 .git、reset 或覆盖共享工作；使用独立分支、保留现场与 git revert 等可审计方式" },
    "approvalPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "approvalType", "reason"],
        "properties": {
          "action": { "type": "string" },
          "approvalType": {
            "type": "string",
            "enum": ["irreversible", "destructive", "release", "security", "local"]
          },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "required": ["maxFiles", "maxCommands", "maxMinutes"],
      "properties": {
        "maxFiles": { "type": "integer", "minimum": 1 },
        "maxCommands": { "type": "integer", "minimum": 1 },
        "maxMinutes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
