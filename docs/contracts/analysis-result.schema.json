{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schemas/analysis-result.schema.json",
  "title": "FrameFlow Select Analysis Result",
  "type": "object",
  "required": ["schemaVersion", "commandId", "analysisRunId", "status", "pipeline", "findings", "usage"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "commandId": {"type": "string"},
    "analysisRunId": {"type": "string"},
    "status": {"enum": ["COMPLETED", "COMPLETED_WITH_FINDINGS", "FAILED", "CANCELLED", "TIMED_OUT"]},
    "decision": {"type": "object", "properties": {"value": {"enum": ["ELIGIBLE", "REVIEW", "REJECT", "ANALYSIS_ERROR"]}, "automatic": {"type": "boolean"}}, "additionalProperties": true},
    "pipeline": {"type": "object"},
    "mediaFacts": {"type": "object"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "qualityVector": {"type": "object"},
    "rankingFeatures": {"type": "object"},
    "usage": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["findingId", "ruleId", "dimension", "verdict", "severity", "confidence", "evidence", "origin"],
      "properties": {
        "findingId": {"type": "string"},
        "ruleId": {"type": "string"},
        "dimension": {"type": "string"},
        "verdict": {"enum": ["SATISFIED", "VIOLATED", "UNKNOWN"]},
        "severity": {"enum": ["BLOCKER", "MAJOR", "MINOR", "INFO"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "automationAction": {"enum": ["REJECT", "REVIEW", "INFO"]},
        "evidence": {"type": "object"},
        "origin": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
