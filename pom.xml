<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.frameflow</groupId>
  <artifactId>frameflow-select</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>FrameFlow Select (learning)</name>
  <description>Learning-first rebuild. Business implementations live only on the archived agent-MVP reference (tag frameflow-select-agent-mvp-v1.0.0).</description>
  <modules>
    <module>frameflow-app</module>
  </modules>
  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.4.5</spring-boot.version>
    <!-- 覆盖 Boot 默认：Docker Engine 29 的 API 代理需要更新的 docker-java 客户端 -->
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><version>${spring-boot.version}</version></plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <!-- ★ 核心：把方法参数名编进字节码（-parameters）。本项目不用
                 spring-boot-starter-parent，拿不到 Boot 默认加的这行配置——
                 缺了它 Spring 6.1+ 无法解析 @PathVariable/@RequestParam 的
                 参数名，接口一调用就 500。这是脱离 parent 管理的最著名陷阱。 -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
          <configuration>
            <!-- ★ 核心：docker-java 默认以旧 API 版本(~1.32)请求 Docker，
                 Docker Engine 29 起 minAPI=1.40，旧版本请求一律 400 空壳响应，
                 Testcontainers 报"Could not find a valid Docker environment"。
                 固定 api.version=1.44（Docker 25+ 均支持）即可；若未来升级
                 Testcontainers 后想移除，先确认其 docker-java 已默认协商新版本。 -->
            <systemPropertyVariables>
              <api.version>1.44</api.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-jdk-17</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,18)</version>
                  <message>FrameFlow Select 基线锁定 JDK 17（项目决策），请使用 JDK 17 构建。</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
