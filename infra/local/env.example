FRAMEFLOW_ENV=local
COMPOSE_PROJECT_NAME=frameflow-local
FRAMEFLOW_VERSION=0.1.0
FRAMEFLOW_GIT_SHA=local

FRAMEFLOW_POSTGRES_PORT=54329
FRAMEFLOW_POSTGRES_DB=frameflow_local
FRAMEFLOW_DB_USERNAME=frameflow_local
FRAMEFLOW_DB_PASSWORD=frameflow_local_only_db
FRAMEFLOW_REDIS_PORT=6379
FRAMEFLOW_REDIS_PASSWORD=frameflow_local_only_redis
FRAMEFLOW_RABBITMQ_PORT=5672
FRAMEFLOW_RABBITMQ_MANAGEMENT_PORT=15672
FRAMEFLOW_RABBITMQ_USER=frameflow_local
FRAMEFLOW_RABBITMQ_PASSWORD=frameflow_local_only_rabbit
FRAMEFLOW_RABBITMQ_VHOST=/frameflow-local

FRAMEFLOW_MINIO_PORT=9000
FRAMEFLOW_MINIO_CONSOLE_PORT=9001
FRAMEFLOW_STORAGE_REGION=us-east-1
FRAMEFLOW_STORAGE_ACCESS_KEY=frameflow_local
FRAMEFLOW_STORAGE_SECRET_KEY=frameflow_local_only_minio
FRAMEFLOW_STORAGE_BUCKET=frameflow-media-local
FRAMEFLOW_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
FRAMEFLOW_STORAGE_CORS_ORIGINS=http://127.0.0.1:3000

FRAMEFLOW_SERVER_PORT=18080
FRAMEFLOW_WEB_PORT=3000
FRAMEFLOW_WORKER_KEY=frameflow_local_only_worker_key
# 平台运维接口（/api/v1/admin/**，如 MQ 队列深度与 DLQ 重放）密钥。
# MQ 是全局基础设施，不能用团队 OWNER 授权（注册即成 OWNER 会让全员可重放
# 所有团队的死信）。留空时这些接口全部拒绝访问（fail-closed）。
FRAMEFLOW_ADMIN_API_KEY=
FRAMEFLOW_WORKER_PREFETCH=2
FRAMEFLOW_WORKER_MAX_ATTEMPT=3
# 容器内 Worker 回调 API 的地址。整栈跑在 Compose 时留空（默认 app:18080）；
# 若把 Java 单独跑在宿主机，改为 http://host.docker.internal:18080。
FRAMEFLOW_WORKER_API_BASE=
FRAMEFLOW_PROVIDER_REQUEST_BUDGET=
FRAMEFLOW_PROVIDER_REQUEST_BUDGET_ID=
FRAMEFLOW_WORKER_TMPFS_SIZE=1g

# F10 观测端口；syslog 只允许 Docker daemon 经宿主 loopback 推送。
FRAMEFLOW_GRAFANA_PORT=13000
FRAMEFLOW_LOKI_PORT=13100
FRAMEFLOW_PROMETHEUS_PORT=19090
FRAMEFLOW_ALERTMANAGER_PORT=19093
FRAMEFLOW_ALERT_SINK_PORT=19094
FRAMEFLOW_ALLOY_SYSLOG_PORT=15140

# 留空表示不启用真实 Provider；JSON 中也永远不能包含 Key。
FRAMEFLOW_SEMANTIC_MODEL_CATALOG_JSON=
# 非空目录启用时必须改为绝对路径；文件须为当前用户所有、0600，且只含目录引用的 Key。
FRAMEFLOW_WORKER_PROVIDER_ENV_FILE=
