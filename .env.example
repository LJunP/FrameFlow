# Local-only example values. Never use these credentials outside the isolated FrameFlow development environment.
FRAMEFLOW_POSTGRES_PORT=54329
FRAMEFLOW_POSTGRES_DB=frameflow
FRAMEFLOW_DB_URL=jdbc:postgresql://127.0.0.1:54329/frameflow
FRAMEFLOW_DB_USERNAME=frameflow
FRAMEFLOW_DB_PASSWORD=frameflow_local_only
FRAMEFLOW_SERVER_ADDRESS=127.0.0.1
FRAMEFLOW_SERVER_PORT=8080
# F3 对象存储（infra/local/docker-compose.yml 的 MinIO）
FRAMEFLOW_STORAGE_ENDPOINT=http://127.0.0.1:9000
FRAMEFLOW_STORAGE_REGION=us-east-1
FRAMEFLOW_STORAGE_ACCESS_KEY=frameflow
FRAMEFLOW_STORAGE_SECRET_KEY=frameflow_local_only
FRAMEFLOW_STORAGE_BUCKET=frameflow-media-local
