# Local-only example values. Never use these credentials outside the isolated FrameFlow development environment.
FRAMEFLOW_ENV=local
COMPOSE_PROJECT_NAME=frameflow-local
FRAMEFLOW_POSTGRES_PORT=54329
FRAMEFLOW_POSTGRES_DB=frameflow_local
FRAMEFLOW_DB_URL=jdbc:postgresql://127.0.0.1:54329/frameflow_local
FRAMEFLOW_DB_USERNAME=frameflow_local
FRAMEFLOW_DB_PASSWORD=frameflow_local_only_db
FRAMEFLOW_REDIS_HOST=127.0.0.1
FRAMEFLOW_REDIS_PORT=6379
FRAMEFLOW_REDIS_PASSWORD=frameflow_local_only_redis
FRAMEFLOW_RABBITMQ_HOST=127.0.0.1
FRAMEFLOW_RABBITMQ_PORT=5672
FRAMEFLOW_RABBITMQ_USER=frameflow_local
FRAMEFLOW_RABBITMQ_PASSWORD=frameflow_local_only_rabbit
FRAMEFLOW_RABBITMQ_VHOST=/frameflow-local
FRAMEFLOW_SERVER_ADDRESS=127.0.0.1
FRAMEFLOW_SERVER_PORT=18080
# F3 对象存储（infra/local/docker-compose.yml 的 MinIO）
FRAMEFLOW_STORAGE_ENDPOINT=http://127.0.0.1:9000
# 浏览器必须拿到可访问的 endpoint；容器环境不能把 http://minio:9000 发给浏览器。
FRAMEFLOW_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
FRAMEFLOW_STORAGE_CORS_ORIGINS=http://127.0.0.1:3000
FRAMEFLOW_STORAGE_REGION=us-east-1
FRAMEFLOW_STORAGE_ACCESS_KEY=frameflow_local
FRAMEFLOW_STORAGE_SECRET_KEY=frameflow_local_only_minio
FRAMEFLOW_STORAGE_BUCKET=frameflow-media-local
FRAMEFLOW_WORKER_KEY=frameflow_local_only_worker_key
FRAMEFLOW_API_BASE=http://127.0.0.1:18080
FRAMEFLOW_COOKIE_SECURE=false
# local 可临时生成 RSA key；dev/staging/production 必须 false + 两个 *_FILE。
FRAMEFLOW_ALLOW_EPHEMERAL_RSA_KEY=true

# F6.1 平台多模型目录：完整无密钥 JSON 见
# experiments/fixtures/pre-f9-correctness/model-catalog.example.json。
# Java API 与 Python Worker 必须接收同一份 JSON；真实 Key 只注入 Worker，
# 不写进 JSON、数据库、前端或仓库。主 env 只设置前两项；最后两项只属于
# FRAMEFLOW_WORKER_PROVIDER_ENV_FILE 指向的 0600 文件：
# FRAMEFLOW_SEMANTIC_MODEL_CATALOG_JSON={...}
# FRAMEFLOW_WORKER_PROVIDER_ENV_FILE=/absolute/path/to/worker-provider.env
# FRAMEFLOW_MODEL_BALANCED_V1_API_KEY=
# FRAMEFLOW_MODEL_QUALITY_V1_API_KEY=
