# Base URL of the FrameFlow Select Java backend (all /api/v1 endpoints).
# Leave unset to default to http://127.0.0.1:8080
FRAMEFLOW_API=http://127.0.0.1:8080

# Optional media-root prefix used to build candidate video URLs in the review player.
# Leave unset to default to the same value as FRAMEFLOW_API.
# FRAMEFLOW_MEDIA=https://cdn.example.com/media
