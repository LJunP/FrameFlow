{
  "schemaVersion": "1.0.0",
  "profileId": "qp_ecommerce_summer_jacket",
  "projectId": "prj_summer_jacket_2026",
  "version": 1,
  "status": "PUBLISHED",
  "name": "夏季防晒衣 9:16 广告质检模板",
  "templateType": "ECOMMERCE_SHORT_VIDEO",
  "description": "用于筛选同一商品批量生成的竖屏短视频广告。硬性规格先行，语义判断默认进入人工复核。",
  "createdAt": "2026-08-20T10:00:00Z",
  "publishedAt": "2026-08-20T10:30:00Z",
  "inputContract": {
    "acceptedMediaTypes": [
      "video/mp4",
      "video/quicktime"
    ],
    "durationSeconds": {
      "minimum": 15,
      "maximum": 25
    },
    "aspectRatio": {
      "expected": "9:16",
      "tolerance": 0.015
    },
    "minimumResolution": {
      "width": 1080,
      "height": 1920
    },
    "audioRequired": true,
    "defaultLanguage": "zh-CN"
  },
  "automationPolicy": {
    "defaultSemanticAction": "REVIEW",
    "autoRejectAllowedRuleTypes": [
      "HARD_CONSTRAINT",
      "DETECTOR_THRESHOLD"
    ],
    "autoRejectMinimumConfidence": 0.98,
    "semanticAutoRejectEnabled": false,
    "unknownResultAction": "REVIEW",
    "maximumCandidateCostUsd": 0.18,
    "maximumProviderCallsPerCandidate": 4
  },
  "rules": [
    {
      "ruleId": "RULE-MEDIA-001",
      "version": 1,
      "type": "HARD_CONSTRAINT",
      "name": "视频时长必须为 15 至 25 秒",
      "dimension": "Q1_FILE_AND_SPEC",
      "severity": "BLOCKER",
      "automationAction": "REJECT",
      "condition": {
        "operator": "BETWEEN",
        "field": "media.durationSeconds",
        "minimum": 15,
        "maximum": 25
      },
      "evidenceRequirement": {
        "mediaFactRequired": true,
        "timeRangeRequired": false,
        "keyframeRequired": false
      }
    },
    {
      "ruleId": "RULE-MEDIA-002",
      "version": 1,
      "type": "HARD_CONSTRAINT",
      "name": "视频必须为 9:16 竖屏",
      "dimension": "Q1_FILE_AND_SPEC",
      "severity": "BLOCKER",
      "automationAction": "REJECT",
      "condition": {
        "operator": "ASPECT_RATIO_MATCH",
        "field": "media.aspectRatio",
        "expected": "9:16",
        "tolerance": 0.015
      },
      "evidenceRequirement": {
        "mediaFactRequired": true,
        "timeRangeRequired": false,
        "keyframeRequired": false
      }
    },
    {
      "ruleId": "RULE-MEDIA-003",
      "version": 1,
      "type": "HARD_CONSTRAINT",
      "name": "视频必须包含音频轨",
      "dimension": "Q5_AUDIO_SPEECH_SUBTITLE",
      "severity": "MAJOR",
      "automationAction": "REJECT",
      "condition": {
        "operator": "EQUALS",
        "field": "media.hasAudioTrack",
        "value": true
      },
      "evidenceRequirement": {
        "mediaFactRequired": true,
        "timeRangeRequired": false,
        "keyframeRequired": false
      }
    },
    {
      "ruleId": "RULE-TECH-001",
      "version": 1,
      "type": "DETECTOR_THRESHOLD",
      "name": "不得存在超过 0.5 秒的黑帧区间",
      "dimension": "Q2_VISUAL_TECHNICAL",
      "severity": "MAJOR",
      "automationAction": "REJECT",
      "detector": {
        "detectorId": "ffmpeg.black_frame",
        "minimumQualifiedVersion": "1.0.0"
      },
      "condition": {
        "operator": "LESS_THAN_OR_EQUAL",
        "field": "finding.maximumDurationMs",
        "value": 500
      },
      "evidenceRequirement": {
        "mediaFactRequired": false,
        "timeRangeRequired": true,
        "keyframeRequired": true
      }
    },
    {
      "ruleId": "RULE-TECH-002",
      "version": 1,
      "type": "DETECTOR_THRESHOLD",
      "name": "不得存在超过 1.0 秒的冻结画面",
      "dimension": "Q4_TEMPORAL_AND_MOTION",
      "severity": "MAJOR",
      "automationAction": "REVIEW",
      "detector": {
        "detectorId": "ffmpeg.freeze_detect",
        "minimumQualifiedVersion": "1.0.0"
      },
      "condition": {
        "operator": "LESS_THAN_OR_EQUAL",
        "field": "finding.maximumDurationMs",
        "value": 1000
      },
      "evidenceRequirement": {
        "mediaFactRequired": false,
        "timeRangeRequired": true,
        "keyframeRequired": true
      }
    },
    {
      "ruleId": "RULE-BRIEF-001",
      "version": 1,
      "type": "SEMANTIC_ASSERTION",
      "name": "前 3 秒必须清楚出现商品",
      "dimension": "Q6_PROMPT_AND_BRIEF_ALIGNMENT",
      "severity": "MAJOR",
      "automationAction": "REVIEW",
      "assertion": {
        "subject": "reference.product",
        "predicate": "isClearlyVisible",
        "timeWindowMs": {
          "start": 0,
          "end": 3000
        },
        "referenceAssetIds": [
          "ref_product_front_white_jacket"
        ]
      },
      "evidenceRequirement": {
        "sourceRequirementRequired": true,
        "timeRangeRequired": true,
        "keyframeRequired": true,
        "minimumKeyframes": 1
      }
    },
    {
      "ruleId": "RULE-BRIEF-002",
      "version": 1,
      "type": "SEMANTIC_ASSERTION",
      "name": "商品主体颜色必须为白色",
      "dimension": "Q6_PROMPT_AND_BRIEF_ALIGNMENT",
      "severity": "MAJOR",
      "automationAction": "REVIEW",
      "assertion": {
        "subject": "primaryProduct",
        "predicate": "dominantColorMatches",
        "expectedValue": "white",
        "referenceAssetIds": [
          "ref_product_front_white_jacket"
        ]
      },
      "evidenceRequirement": {
        "sourceRequirementRequired": true,
        "timeRangeRequired": true,
        "keyframeRequired": true,
        "minimumKeyframes": 1
      }
    },
    {
      "ruleId": "RULE-BRIEF-003",
      "version": 1,
      "type": "SEMANTIC_ASSERTION",
      "name": "视频必须表达轻薄和防晒两个核心卖点",
      "dimension": "Q6_PROMPT_AND_BRIEF_ALIGNMENT",
      "severity": "MAJOR",
      "automationAction": "REVIEW",
      "assertion": {
        "subject": "videoMessage",
        "predicate": "containsAllConcepts",
        "expectedValues": [
          "轻薄",
          "防晒"
        ],
        "allowedEvidenceChannels": [
          "speech_transcript",
          "ocr_text",
          "visual_semantics"
        ]
      },
      "evidenceRequirement": {
        "sourceRequirementRequired": true,
        "timeRangeRequired": true,
        "keyframeRequired": false,
        "transcriptSpanRequired": true
      }
    },
    {
      "ruleId": "RULE-BRIEF-004",
      "version": 1,
      "type": "SEMANTIC_ASSERTION",
      "name": "结尾必须包含购买行动号召",
      "dimension": "Q7_BRAND_AND_PUBLISH_READINESS",
      "severity": "MINOR",
      "automationAction": "REVIEW",
      "assertion": {
        "subject": "videoEnding",
        "predicate": "containsCallToAction",
        "timeWindowRelativeToEndMs": 4000,
        "acceptedIntents": [
          "立即购买",
          "点击购买",
          "进入店铺",
          "领取优惠"
        ]
      },
      "evidenceRequirement": {
        "sourceRequirementRequired": true,
        "timeRangeRequired": true,
        "keyframeRequired": true,
        "transcriptSpanRequired": true
      }
    },
    {
      "ruleId": "RULE-PROHIBITED-001",
      "version": 1,
      "type": "PROHIBITED_ASSERTION",
      "name": "不得出现竞品 Logo",
      "dimension": "Q7_BRAND_AND_PUBLISH_READINESS",
      "severity": "BLOCKER",
      "automationAction": "REVIEW",
      "assertion": {
        "subject": "videoFrames",
        "predicate": "doesNotContainAnyReference",
        "prohibitedReferenceAssetIds": [
          "ref_competitor_logo_a",
          "ref_competitor_logo_b"
        ]
      },
      "evidenceRequirement": {
        "sourceRequirementRequired": true,
        "timeRangeRequired": true,
        "keyframeRequired": true,
        "minimumKeyframes": 1
      }
    }
  ],
  "ranking": {
    "dimensions": {
      "Q2_VISUAL_TECHNICAL": 0.12,
      "Q3_AI_STRUCTURAL_ARTIFACTS": 0.15,
      "Q4_TEMPORAL_AND_MOTION": 0.12,
      "Q5_AUDIO_SPEECH_SUBTITLE": 0.12,
      "Q6_PROMPT_AND_BRIEF_ALIGNMENT": 0.18,
      "Q7_BRAND_AND_PUBLISH_READINESS": 0.10,
      "Q8_AESTHETIC_AND_CREATIVE_FIT": 0.12,
      "Q9_DUPLICATION_AND_DIVERSITY": 0.09
    },
    "findingPenalties": {
      "BLOCKER": 1.0,
      "MAJOR": 0.20,
      "MINOR": 0.05,
      "INFO": 0.0
    },
    "unknownDimensionPolicy": "RENORMALIZE_AVAILABLE_WEIGHTS",
    "minimumDimensionsForRanking": 5
  },
  "diversityPolicy": {
    "enabled": true,
    "similarityModelId": "video-embedding-v1",
    "nearDuplicateThreshold": 0.94,
    "clusterThreshold": 0.88,
    "maximumCandidatesPerClusterInTopK": 1,
    "selectionAlgorithm": "MMR",
    "lambda": 0.75
  },
  "budget": {
    "mode": "BALANCED",
    "maximumBatchCostUsd": 20.0,
    "stopExpensiveStagesWhenExceeded": true
  },
  "retention": {
    "sourceMediaDays": 30,
    "derivedMediaDays": 14,
    "analysisMetadataDays": 180
  }
}
